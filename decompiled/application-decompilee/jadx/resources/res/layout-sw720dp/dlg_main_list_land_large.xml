<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivParent"
        android:layout_width="0px"
        android:layout_height="0px"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.zdevs.zarchiver.p045ui.list.FitListView
        android:id="@+id/lvFavorite"
        android:layout_width="0px"
        android:layout_height="0px"
        android:cacheColorHint="@android:color/transparent"
        android:smoothScrollbar="false"
        app:layout_constraintBottom_toTopOf="@+id/vDiv2"
        app:layout_constraintEnd_toStartOf="@+id/fp"
        app:layout_constraintHorizontal_weight="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vDiv"
        android:background="?android:attr/listDivider"
        android:layout_width="1dp"
        android:layout_height="0px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lvFavorite"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vDiv2"
        android:background="?android:attr/listDivider"
        android:layout_width="0px"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/tvStorage"
        app:layout_constraintEnd_toEndOf="@+id/lvFavorite"
        app:layout_constraintStart_toStartOf="@+id/lvFavorite"
        app:layout_constraintTop_toBottomOf="@+id/lvFavorite"/>
    <TextView
        android:textAppearance="?android:attr/textAppearance"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/tvStorage"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/tvStorageSpace"
        app:layout_constraintEnd_toEndOf="@+id/lvFavorite"
        app:layout_constraintStart_toStartOf="@+id/lvFavorite"
        app:layout_constraintTop_toBottomOf="@+id/vDiv2"/>
    <TextView
        android:textAppearance="?android:attr/textAppearance"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/tvStorageSpace"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/tvFolder"
        app:layout_constraintEnd_toEndOf="@+id/lvFavorite"
        app:layout_constraintStart_toStartOf="@+id/lvFavorite"
        app:layout_constraintTop_toBottomOf="@+id/tvStorage"/>
    <TextView
        android:textAppearance="?android:attr/textAppearance"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/tvFolder"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/tvFolderSize"
        app:layout_constraintEnd_toEndOf="@+id/lvFavorite"
        app:layout_constraintStart_toStartOf="@+id/lvFavorite"
        app:layout_constraintTop_toBottomOf="@+id/tvStorageSpace"/>
    <TextView
        android:textAppearance="?android:attr/textAppearance"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/tvFolderSize"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/lvFavorite"
        app:layout_constraintStart_toStartOf="@+id/lvFavorite"
        app:layout_constraintTop_toBottomOf="@+id/tvFolder"/>
    <ru.zdevs.zarchiver.p045ui.FilePanelView
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/fp"
        android:layout_width="0px"
        android:layout_height="0px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.7"
        app:layout_constraintStart_toEndOf="@+id/lvFavorite"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ibActionBg"
        android:visibility="gone"
        android:layout_width="0px"
        android:layout_height="0px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.zdevs.zarchiver.p045ui.ctrl.fab.FloatingActionMenu
        android:id="@+id/ibAction"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/fp"
        app:layout_constraintRight_toRightOf="@+id/fp"
        style="@style/FloatingActionButtonStyle"/>
</android.support.constraint.ConstraintLayout>
