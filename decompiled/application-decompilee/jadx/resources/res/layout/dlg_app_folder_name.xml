<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/padding_tiny"
    android:paddingRight="@dimen/padding_tiny"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:isScrollContainer="true">
    <TextView
        android:textAppearance="?android:attr/textAppearance"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/NF_ENTER_FOLDER_NAME"
        android:textAlignment="viewStart"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.zdevs.zarchiver.p045ui.text.ExEditText
            android:gravity="start|center_vertical"
            android:id="@+id/edt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/btn_select"
            android:importantForAccessibility="no"
            android:layout_toStartOf="@+id/btn_select"/>
        <Button
            android:id="@+id/btn_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            android:text="@string/SELECT_PWD"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
