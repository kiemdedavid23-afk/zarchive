<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/padding_tiny"
    android:paddingRight="@dimen/padding_tiny"
    android:paddingBottom="@dimen/padding_tiny"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/defaultTextColorFileList"
        android:gravity="start|center_vertical"
        android:id="@+id/tvStorage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toStartOf="@+id/tvFolder"
        app:layout_constraintHorizontal_weight="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_editor_absoluteY="0dp"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/defaultTextColorFileList"
        android:gravity="start|center_vertical"
        android:id="@+id/tvFolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.4"
        app:layout_constraintStart_toEndOf="@+id/tvStorage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_editor_absoluteY="0dp"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/defaultTextColorFileList"
        android:gravity="start|center_vertical"
        android:id="@+id/tvStorageSpace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="@+id/tvStorage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStorage"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/defaultTextColorFileList"
        android:gravity="start|center_vertical"
        android:id="@+id/tvFolderSize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="@+id/tvFolder"
        app:layout_constraintStart_toStartOf="@+id/tvFolder"
        app:layout_constraintTop_toBottomOf="@+id/tvFolder"/>
    <ProgressBar
        android:id="@+id/pbFree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintTop_toBottomOf="@+id/tvStorageSpace"
        style="?android:attr/progressBarStyleHorizontal"/>
</android.support.constraint.ConstraintLayout>
