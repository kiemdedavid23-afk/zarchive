<?xml version="1.0" encoding="utf-8"?>
<com.sothree.slidinguppanel.SlidingUpPanelLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:id="@+id/sup_sliding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:umanoDragView="@+id/sup_container"
    app:umanoFadeColor="@android:color/transparent"
    app:umanoPanelHeight="0dp">
    <View
        android:id="@+id/outside"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/sup_container"
        android:background="@drawable/bg_bottom_menu"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearance"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:paddingLeft="@dimen/padding_default"
            android:paddingTop="@dimen/padding_tiny"
            android:paddingRight="@dimen/padding_default"
            android:paddingBottom="@dimen/padding_tiny"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottomsheet_header"
            android:text="@string/MENU_OPEN"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/expand"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@+id/expand"
            android:layout_alignParentStart="true"
            style="@android:style/TextAppearance.DialogWindowTitle"/>
        <ImageView
            android:id="@+id/expand"
            android:paddingRight="@dimen/padding_tiny"
            android:visibility="gone"
            android:src="?attr/bottomSheetExpandIcon"
            android:layout_alignTop="@+id/title"
            android:layout_alignBottom="@+id/title"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:contentDescription="@null"
            android:paddingEnd="@dimen/padding_tiny"
            android:layout_alignParentEnd="true"
            style="@style/InlineButton"/>
        <View
            android:background="?attr/colorAccent"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignBottom="@+id/title"/>
        <ImageButton
            android:id="@+id/ib_action"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"/>
        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:dividerHeight="0dp"
            android:layout_below="@+id/title"/>
    </RelativeLayout>
</com.sothree.slidinguppanel.SlidingUpPanelLayout>
