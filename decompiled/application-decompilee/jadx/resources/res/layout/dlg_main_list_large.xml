<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivParent"
        android:layout_width="0px"
        android:layout_height="0px"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.zdevs.zarchiver.p045ui.FilePanelView
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/fp"
        android:layout_width="0px"
        android:layout_height="0px"
        app:layout_constraintBottom_toTopOf="@+id/vDiv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vDiv"
        android:background="?android:attr/listDivider"
        android:layout_width="0px"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/tvStorage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fp"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/tvStorage"
        android:paddingLeft="2dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/tvStorageSpace"
        app:layout_constraintEnd_toStartOf="@+id/tvFolder"
        app:layout_constraintHorizontal_weight="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vDiv"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/tvStorageSpace"
        android:paddingLeft="4dp"
        android:paddingRight="2dp"
        android:paddingBottom="4dp"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvFolderSize"
        app:layout_constraintHorizontal_weight="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStorage"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/tvFolder"
        android:paddingLeft="2dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/tvFolderSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvStorage"
        app:layout_constraintTop_toBottomOf="@+id/vDiv"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:id="@+id/tvFolderSize"
        android:paddingLeft="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvStorageSpace"
        app:layout_constraintTop_toBottomOf="@+id/tvFolder"/>
    <View
        android:id="@+id/ibActionBg"
        android:visibility="gone"
        android:layout_width="0px"
        android:layout_height="0px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ru.zdevs.zarchiver.p045ui.ctrl.fab.FloatingActionMenu
        android:id="@+id/ibAction"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/fp"
        app:layout_constraintEnd_toEndOf="@+id/fp"
        app:layout_constraintRight_toRightOf="@+id/fp"
        style="@style/FloatingActionButtonStyle"/>
</android.support.constraint.ConstraintLayout>
