<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sothree.slidinguppanel.SlidingUpPanelLayout
        android:gravity="bottom"
        android:id="@+id/sup_sliding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:umanoAnchorOffset="@dimen/bottomsheet_height"
        app:umanoDragView="@+id/sup_container"
        app:umanoFadeColor="@android:color/transparent"
        app:umanoPanelHeight="0dp">
        <View
            android:id="@+id/outside"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/sup_container"
            android:background="@drawable/bg_bottom_menu"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-24dp"
            android:minHeight="@dimen/bottomsheet_height">
            <TextView
                android:textAppearance="?android:attr/textAppearance"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:paddingLeft="@dimen/padding_default"
                android:paddingTop="@dimen/padding_tiny"
                android:paddingRight="@dimen/padding_default"
                android:paddingBottom="@dimen/padding_tiny"
                android:focusable="false"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bottomsheet_header_big"
                android:text="@string/MENU_OPEN"
                style="@android:style/TextAppearance.DialogWindowTitle"/>
            <View
                android:background="?android:attr/listDivider"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignBottom="@+id/title"/>
            <ImageButton
                android:id="@+id/ib_action"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:layout_alignParentEnd="true"/>
            <ListView
                android:id="@android:id/list"
                android:paddingBottom="@dimen/open_as_button_height"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:layout_below="@+id/title"/>
        </RelativeLayout>
    </com.sothree.slidinguppanel.SlidingUpPanelLayout>
    <LinearLayout
        android:gravity="end"
        android:layout_gravity="bottom"
        android:id="@+id/ll_buttons"
        android:background="?android:attr/colorBackground"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp">
        <Button
            android:id="@+id/btn_once"
            android:text="@string/BTN_USE_ONCE"
            style="@style/OpenAsBottomButton"/>
        <Button
            android:textColor="?android:attr/colorAccent"
            android:id="@+id/btn_always"
            android:text="@string/BTN_USE_ALWAYS"
            style="@style/OpenAsBottomButton"/>
    </LinearLayout>
</FrameLayout>
