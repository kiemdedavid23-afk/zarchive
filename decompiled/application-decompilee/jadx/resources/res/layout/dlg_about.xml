<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/svAbout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_appname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_version"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_AUTHOR"
            android:textIsSelectable="true"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:autoLink="web"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_APP_WEBSITE"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?attr/colorPrimary"
            android:autoLink="web"
            android:id="@+id/tv_terms_of_service"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_TERM_OF_SERVICE"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?attr/colorPrimary"
            android:autoLink="web"
            android:id="@+id/tv_privacy_policy"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_PRIVACY_POLICY"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_DONATE"
            android:textAlignment="viewStart"/>
        <View
            android:background="#cccccc"
            android:paddingLeft="5dp"
            android:paddingTop="50dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:autoLink="web"
            android:id="@+id/tv_donate"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_DONATE_GENERAL"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_DONATE_PAY"
            android:textIsSelectable="true"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_THANKS"
            android:textAlignment="viewStart"/>
        <View
            android:background="#cccccc"
            android:paddingLeft="5dp"
            android:paddingTop="50dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_TRANSLATORS"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE"
            android:textAlignment="viewStart"/>
        <View
            android:background="#cccccc"
            android:paddingLeft="5dp"
            android:paddingTop="50dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_7ZIP"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_ICONV"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_UNRAR"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_LZ4"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_ZSTD"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_FREELZMA2"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_UNEGG"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_BUSYBOX"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_R2D2"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_FREEBSD"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_AOSP"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_TOASTCOMPAT"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_APKPARSER"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_SUBSAMPLING_IV"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_ICON_1"
            android:textAlignment="viewStart"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ABT_OPEN_SOURCE_ICON_5"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</ScrollView>
