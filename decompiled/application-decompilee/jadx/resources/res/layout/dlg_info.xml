<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/padding_tiny"
    android:paddingRight="@dimen/padding_tiny"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:isScrollContainer="true">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold"
        android:gravity="start|center_vertical"
        android:id="@+id/tvFileName"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"/>
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1,2"
        android:shrinkColumns="2">
        <TableRow>
            <TextView
                android:textAppearance="?android:attr/textAppearance"
                android:textStyle="bold"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_span="2"
                android:text="@string/FINFO_GENERAL_INFO"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
        </TableRow>
        <TableRow>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_TYPE"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvFileType"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/trLinkTo"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_LINK_TO"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:gravity="start|center_vertical"
                android:id="@+id/tvLinkTo"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/trFileCount"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_ARCHIVE_FILE_COUNT"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvFileCount"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_SIZE"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:gravity="start|center_vertical"
                android:id="@+id/tvFileSize"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_LAST_MOD"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:gravity="start|center_vertical"
                android:id="@+id/tvFileLastMod"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/trUserGroup"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_USER_GROUP"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:gravity="start|center_vertical"
                android:id="@+id/tvUserGroup"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/trPermissions"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_PERMISSIONS"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:gravity="start|center_vertical"
                android:id="@+id/tvPermissions"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_FS_PATH"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="start"
                android:gravity="start|center_vertical"
                android:id="@+id/tvFSPath"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_FS_TYPE"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:gravity="start|center_vertical"
                android:id="@+id/tvFSType"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow android:id="@+id/trMD5">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FINFO_MD5"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
        </TableRow>
    </TableLayout>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:gravity="start|center_vertical"
        android:id="@+id/tvFileMD5"
        android:paddingLeft="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textIsSelectable="true"
        android:textAlignment="viewStart"
        android:paddingStart="4dp"/>
    <CheckBox
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:ellipsize="none"
        android:gravity="start|center_vertical"
        android:id="@+id/cbNomedia"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/FINFO_NOMEDIA"
        android:singleLine="true"
        android:textAlignment="viewStart"/>
    <TableLayout
        android:id="@+id/tlMediaInfo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1,2"
        android:shrinkColumns="2">
        <TableRow>
            <TextView
                android:textAppearance="?android:attr/textAppearance"
                android:textStyle="bold"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvMediaHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_span="2"
                android:text="@string/FINFO_IMAGE_INFO"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
        </TableRow>
        <TableRow
            android:id="@+id/trMedia1"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:id="@+id/tvTitlMedia1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvMedia1"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/trMedia2"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:id="@+id/tvTitlMedia2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvMedia2"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/trMedia3"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:id="@+id/tvTitlMedia3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvMedia3"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/trMedia4"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:id="@+id/tvTitlMedia4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvMedia4"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/trMedia5"
            android:visibility="gone">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:id="@+id/tvTitlMedia5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvMedia5"
                android:paddingLeft="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                android:paddingStart="4dp"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
