<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rlTitle"
        android:padding="@dimen/padding_micro"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_default_height"
        style="?android:attr/actionBarStyle">
        <ImageView
            android:id="@+id/bBack"
            android:padding="@dimen/padding_icon"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/floating_action_button_size"
            android:layout_height="@dimen/floating_action_button_size_small"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            style="?android:attr/actionButtonStyle"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?android:attr/actionMenuTextColor"
            android:id="@+id/nTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/bMenu"
            android:layout_toRightOf="@+id/bBack"
            android:layout_centerVertical="true"
            android:textIsSelectable="false"
            android:layout_toStartOf="@+id/bMenu"
            android:layout_toEndOf="@+id/bBack"/>
        <ImageView
            android:id="@+id/bMenu"
            android:padding="@dimen/padding_icon"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/floating_action_button_size_small"
            android:layout_height="@dimen/floating_action_button_size_small"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"
            style="?android:attr/actionOverflowButtonStyle"/>
    </RelativeLayout>
    <include layout="@layout/dlg_edit_base"/>
</LinearLayout>
