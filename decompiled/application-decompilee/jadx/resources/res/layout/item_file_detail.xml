<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/backgroundColorFileListItem"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <ImageView
        android:id="@+id/icon"
        android:padding="2dp"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginRight="5dp"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@null"
        android:layout_marginEnd="5dp"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="?attr/defaultTextColorFileList"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="5"
        android:layout_toRightOf="@+id/icon"
        android:layout_alignParentTop="true"
        android:textIsSelectable="false"
        android:layout_toEndOf="@+id/icon"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="?attr/defaultTextColorFileListSub"
        android:ellipsize="end"
        android:id="@+id/info_size"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/info_date"
        android:layout_toRightOf="@+id/icon"
        android:layout_below="@+id/label"
        android:textIsSelectable="false"
        android:paddingEnd="4dp"
        android:layout_toStartOf="@+id/info_date"
        android:layout_toEndOf="@+id/icon"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="?attr/defaultTextColorFileListSub"
        android:id="@+id/info_date"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/label"
        android:layout_alignParentRight="true"
        android:textIsSelectable="false"
        android:paddingEnd="4dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
