<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="1dp"
    android:paddingTop="10dp"
    android:paddingRight="1dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rlNavigation"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textAppearance="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="start|center_vertical"
                android:id="@+id/nTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textIsSelectable="false"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Subtitle"
                android:textColor="?android:attr/textColorPrimary"
                android:ellipsize="start"
                android:gravity="start|center_vertical"
                android:id="@+id/nSubtitle"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textIsSelectable="false"
                android:textAlignment="viewStart"
                android:paddingEnd="16dp"/>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/iconNavigationDown"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ru.zdevs.zarchiver.p045ui.FSSelect
        android:id="@+id/fs_select"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_above="@+id/samePath"
        android:layout_below="@+id/rlNavigation"/>
    <CheckBox
        android:id="@+id/samePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/OPT_HOME_SAME"
        android:layout_above="@+id/tabSelection"/>
    <RadioGroup
        android:id="@+id/tabSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearance"
        android:textColor="?attr/defaultTextColorFileListMessage"
        android:gravity="center"
        android:id="@+id/tv_empty_list"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/fs_select"
        android:layout_alignTop="@+id/fs_select"
        android:layout_alignRight="@+id/fs_select"
        android:layout_alignBottom="@+id/fs_select"
        android:layout_alignStart="@+id/fs_select"
        android:layout_alignEnd="@+id/fs_select"/>
</RelativeLayout>
