<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="10dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="15dp">
    <TextView
        android:textAppearance="?android:attr/textAppearance"
        android:gravity="start|center_vertical"
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvProgressCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProgress"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:gravity="start|center_vertical"
        android:id="@+id/tvProgressName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:maxLines="2"
        android:lines="2"
        android:minLines="2"
        android:singleLine="false"
        android:textAlignment="viewStart"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@+id/tvProgressPercent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProgressCaption"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textStyle="bold"
        android:gravity="end|center_vertical"
        android:id="@+id/tvProgressPercent"
        android:layout_width="wrap_content"
        android:layout_height="0px"
        android:lines="2"
        android:ems="4"
        android:textAlignment="viewEnd"
        app:layout_constraintBottom_toBottomOf="@+id/tvProgressName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvProgressName"/>
    <ProgressBar
        android:id="@+id/pbProgress"
        android:paddingTop="10dp"
        android:paddingBottom="5dp"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProgressName"
        style="?android:attr/progressBarStyleHorizontal"/>
    <CheckBox
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/cbKeepScreenOn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/PD_KEEP_SCREEN_ON"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pbProgress"/>
</android.support.constraint.ConstraintLayout>
