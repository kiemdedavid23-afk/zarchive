<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/toolbarMenuStyle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <GridLayout
        android:id="@+id/grid"
        android:padding="@dimen/menu_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:columnOrderPreserved="true">
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/viewMode"
            android:text="@string/MENU_VIEW_MODE"
            android:layout_columnSpan="5"/>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/viewListDetail"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconListDetail">
            <requestFocus/>
        </ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/viewList"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconList"/>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/viewGrid"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconGrid"/>
        <View
            android:layout_width="0px"
            android:layout_height="0px"/>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/showHidden"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconHidden"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_VIEW_DETAIL"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_VIEW_COMPACT"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:id="@+id/showGridLabel"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_VIEW_GRID"/>
        <View
            android:layout_width="0px"
            android:layout_height="0px"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_VIEW_HIDDEN"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/sortMode"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_micro"
            android:text="@string/MENU_SORT_MODE"
            android:layout_columnSpan="5"/>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/sortByName"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconSortName"/>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/sortBySize"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconSortSize"/>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/sortByDate"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconSortDate"/>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/sortByType"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconSortType"/>
        <ru.zdevs.zarchiver.p045ui.ctrl.MenuToggleButton
            android:layout_gravity="center"
            android:id="@+id/sortDesc"
            android:layout_width="@dimen/menu_item_toggle_size"
            android:layout_height="@dimen/menu_item_toggle_size"
            app:srcCompat="?attr/menuIconSortDesc"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_SORT_BY_NAME"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_SORT_BY_SIZE"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_SORT_BY_DATE"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_SORT_BY_TYPE"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:padding="@dimen/padding_micro"
            android:paddingBottom="@dimen/padding_default"
            android:maxWidth="@dimen/menu_item_toggle_size_max"
            android:text="@string/MENU_SORT_DESC"/>
    </GridLayout>
</ScrollView>
